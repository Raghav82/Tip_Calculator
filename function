
def tip_calculator():
    tip_input = input("Please enter the total cost of the meal: ")
    try:
        meal_cost = float(tip_input)
        tip = meal_cost * 0.18
        tax = meal_cost * 0.07
        total = meal_cost + tip + tax
        print("You entered:", meal_cost)
        print("Calculated tip (18%): $", round(tip, 2))
        print("Calculated sales tax (7%): $", round(tax, 2))
        print("Total amount (meal + tip + tax): $", round(total, 2))
    except ValueError:
        print("Invalid input. Please enter a numeric value.")

# Call the function
tip_calculator()
